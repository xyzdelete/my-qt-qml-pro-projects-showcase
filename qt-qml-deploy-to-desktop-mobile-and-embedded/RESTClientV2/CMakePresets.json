{
  "version": 10,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "f35a9ac6-8463-4d38-8eec-5d6008153e7d",
        "CMAKE_CXX_MODULE_STD": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "ON",
        "QT_QML_GENERATE_QMLLS_INI": "ON",
        "USE_VCPKG": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "$penv{SystemDrive}/build/${presetName}",
      "installDir": "$penv{SystemDrive}/build/${presetName}/install/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_INSTALLED_DIR": "$penv{SystemDrive}/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=$penv{SystemDrive}/vcpkg_buildtrees"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-windows-static",
      "inherits": "windows-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_STATIC_LINKAGE": "ON"
      }
    },
    {
      "name": "x64-windows-static-md",
      "inherits": "windows-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "VCPKG_STATIC_LINKAGE": "ON"
      }
    },
    {
      "name": "x64-windows",
      "inherits": "windows-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "VCPKG_STATIC_LINKAGE": "OFF"
      }
    },
    {
      "name": "arm64-windows-static-md",
      "inherits": "windows-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "VCPKG_STATIC_LINKAGE": "ON"
      }
    },
    {
      "name": "arm64-windows",
      "inherits": "windows-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "VCPKG_STATIC_LINKAGE": "OFF"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "installDir": "${sourceDir}/build/${presetName}/install/${sourceDirName}/AppDir/usr",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "x64-linux",
      "inherits": "linux-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
