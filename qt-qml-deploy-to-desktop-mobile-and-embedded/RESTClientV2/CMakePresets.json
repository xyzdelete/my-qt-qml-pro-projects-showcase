      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26",
        "VCPKG_STATIC_LINKAGE": "ON"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "environment": {
        "JAVA_HOME": "$penv{JAVA_HOME}",
        "ANDROID_HOME": "$penv{ANDROID_HOME}",
        "ANDROID_SKD_ROOT": "$env{ANDROID_HOME}",
        "ANDROID_NDK_HOME": "$penv{ANDROID_NDK_HOME}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_HOME}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_ROOT}",
        "CMAKE_ANDROID_API": "35",
        "ANDROID_MIN_SDK_VERSION": "30",
        "ANDROID_TARGET_SDK_VERSION": "$env{CMAKE_ANDROID_API}",
        "ANDROID_COMPILE_SDK_VERSION": "36",
        "CMAKE_ANDROID_STL_TYPE": "c++_static"
      }
    },
    {
      "name": "arm64-android",
      "inherits": "android-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
        "VCPKG_STATIC_LINKAGE": "ON"
      }
    },
    {
      "name": "x64-android",
      "inherits": "android-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-android",
        "CMAKE_ANDROID_ARCH_ABI": "x86_64",
        "VCPKG_STATIC_LINKAGE": "ON"
      }
    }
